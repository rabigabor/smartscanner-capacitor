{
  "name": "@idpass/smartscanner-capacitor",
  "version": "0.4.0-beta.1",
  "description": "Capacitor plugin for the SmartScanner Core library to scan MRZ, NFC and barcodes",
  "main": "dist/plugin.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "lint": "npm run prettier -- --check && npm run swiftlint -- lint",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "author": "NewLogic",
  "license": "Apache-2.0",
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@rollup/plugin-node-resolve": "^8.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-java": "^2.6.6",
    "rimraf": "^6.0.1",
    "rollup": "^4.30.1",
    "swiftlint": "^2.0.0",
    "typescript": "~3.8.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "files": [
    "dist/",
    "ios/",
    "ios/Plugin",
    "android/",
    "IdpassSmartscannerCapacitor.podspec"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/idpass/smartscanner-capacitor.git"
  },
  "bugs": {
    "url": "https://github.com/idpass/smartscanner-capacitor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
